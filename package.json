  },
  "dependencies": {
    "@mind-elixir/import-xmind": "1.0.8",
    "aws4fetch": "1.0.20",
    "fflate": "0.8.3",
    "jose": "6.2.17",
    "mind-elixir": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251117.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "wrangler": "4.165.0"
  }
}
